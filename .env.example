# Server-side Gemini API Configuration (Private - Never commit .env)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
PORT=3001
NODE_ENV=development
ADMIN_SECRET_KEY=replace_with_strong_random_secret

# Optional Client-Side Base URL (leave empty when Express serves frontend or Vite proxy handles /api)
VITE_API_BASE_URL=
